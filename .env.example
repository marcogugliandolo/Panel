# Copia este fichero como .env para desarrollo local, o define estas variables en el stack de Portainer.

# Acceso al panel (obligatorio en producción)
PANEL_USERNAME=admin
PANEL_PASSWORD=

# Token que deben enviar los scripts de métricas (Authorization: Bearer <token>).
# Genera uno con: openssl rand -hex 32
# Vacío = se aceptan métricas sin token (solo mientras actualizas los scripts).
STATS_TOKEN=

# Control de contenedores (opcional). Token en Portainer → My account → Access tokens.
PORTAINER_URL=https://portainer.marcogugliandolo.com
PORTAINER_TOKEN=

# Minutos sin recibir métricas para marcar un servidor como caído (los scripts envían cada minuto).
OFFLINE_AFTER_MINUTES=5

# Días de historial que se conservan (métricas y comprobaciones de webs).
HISTORY_DAYS=30

# Puerto interno del servidor
PORT=3000
